# ==============================================================================
# 🎓 ACADEMIC PORTFOLIO & FACULTY CMS — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions for IIT Indore Academic Office / System Administrators:
# 1. Copy this file to `.env` in the root directory: cp .env.example .env
# 2. Fill in the values below. All mandatory fields are marked with [REQUIRED].
# 3. For any questions, refer to the detailed README.md file in the project root.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION [REQUIRED]
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL.
# Supports Local PostgreSQL, Supabase, Neon, Railway, or Campus DB servers.
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
#
# Examples:
# - Local PostgreSQL:   "postgresql://postgres:password123@localhost:5432/abhishek_portfolio?schema=public"
# - Supabase (Cloud):   "postgresql://postgres.xxxx:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# - Neon (Cloud):       "postgresql://user:password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/professor_portfolio?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY [REQUIRED]
# ------------------------------------------------------------------------------
# Secret key used to cryptographically sign and verify admin session cookies.
# Must be at least 32 characters long.
#
# How to generate on Linux / macOS / Git Bash:
#   openssl rand -base64 32
# How to generate in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long-example-replace-this"

# ------------------------------------------------------------------------------
# 3. PUBLIC WEBSITE URL [REQUIRED]
# ------------------------------------------------------------------------------
# Base URL of the website. Used to generate absolute URLs in emails & SEO tags.
# Do NOT include a trailing slash at the end.
#
# Examples:
# - Local Development:   "http://localhost:3000"
# - Production (IIT):    "https://dr-abhishek-rajput.iiti.ac.in"
# - Production (Cloud):  "https://abhishek-rajput-portfolio.vercel.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL DELIVERY (SMTP) [RECOMMENDED]
# ------------------------------------------------------------------------------
# Used to dispatch secure, single-use password reset links to the administrator.
# The reset link is sent strictly to the admin's inbox and is never shown openly.
#
# Option A: Gmail SMTP (Simplest & Most Reliable)
#   NOTE: You CANNOT use your standard Gmail password. You must generate a
#   16-character Google App Password:
#   1. Go to: https://myaccount.google.com/security
#   2. Ensure "2-Step Verification" is ON.
#   3. Go to: https://myaccount.google.com/apppasswords
#   4. Enter "Academic Portfolio", click Create, and copy the 16-letter code.
#   5. Paste below as SMTP_PASS without spaces (e.g. "abcd efgh ijkl mnop").
#
# Option B: Institutional IIT Indore SMTP Server
#   SMTP_HOST="smtp.iiti.ac.in" or your department relay
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="faculty.email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="\"Dr. Abhishek Rajput Academic Portal\" <no-reply@iiti.ac.in>"

# ------------------------------------------------------------------------------
# 5. FILE STORAGE CONFIGURATION [OPTIONAL - Defaults to 'local']
# ------------------------------------------------------------------------------
# Where uploaded documents (CV PDF, publication reprints, student avatars) live.
# Supported values: "local", "s3", "cloudinary", "supabase"
# When set to "local", files are safely stored inside the "public/uploads/" folder.
STORAGE_TYPE="local"
STORAGE_PROVIDER="local"
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_SECRET=""

# ------------------------------------------------------------------------------
# 6. EMERGENCY RECOVERY KEY [OPTIONAL]
# ------------------------------------------------------------------------------
# Master recovery passkey used by system administrators in emergency scenarios.
ADMIN_RECOVERY_KEY="rajput-academic-recovery-master-key-2026"
